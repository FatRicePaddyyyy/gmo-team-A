# S-I: scripts / backend で使う環境変数のテンプレート。
# 実際の値は個々の開発者が .env に書く (`.env` は .gitignore 済み)。

# better-auth のセッション署名鍵。ランダムな 32 バイト hex を推奨。
BETTER_AUTH_SECRET=change-me-random-32byte-hex

# /api/v1/secret/* の Bearer トークン。
# scripts/*-e2e.sh もこの値を `SECRET_KEY` として参照する。
# `openssl rand -hex 16` などで生成し .env に書く。
SECRET_KEY=change-me-random-32byte-hex

# Kitaqsign レジストリ (com/net など)
KITAQSIGN_BASIC_USER=
KITAQSIGN_BASIC_PASS=
KITAQSIGN_REGISTRAR_ID=
KITAQSIGN_API_KEY=

# Kitaqnic レジストリ (jp)
KITAQNIC_BASIC_USER=
KITAQNIC_BASIC_PASS=
KITAQNIC_REGISTRAR_ID=
KITAQNIC_API_KEY=
