{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-local",
      "database_id": "8e8147c0-2a7c-4e14-97b6-8fd63e7cea85",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "BACKEND_URL": "http://localhost:8787",
    "FRONTEND_URL": "http://localhost:3000",
    "crossSubDomainCookies": "localhost",
    "KITAQSIGN_BASE_URL": "https://epp.kitaqsign.com",
    "KITAQNIC_BASE_URL": "https://epp.kitaqnic.com"
  },
  "triggers": {
    // 移管ポーリングは 1 分ごとの cron で駆動する (scheduled/transfer-cron-poll)。
    // 発火のたびに両レジストリを空になるまで poll drain して確定処理し、22 分以上経過した
    // pendingTransfer は info で真実確認して serverApproved / expired に確定させる。
    // Cloudflare Queues は一切使わず、Cron トリガーだけで移管の poll と reconcile を完結させる。
    "crons": ["* * * * *"]
  },
  "env": {
    "production": {
      "name": "backend-production",
      "vars": {
        "BACKEND_URL": "https://backend-production.fatricepaddy.workers.dev",
        "FRONTEND_URL": "https://frontend-production.fatricepaddy.workers.dev",
        "crossSubDomainCookies": ".fatricepaddy.workers.dev",
        "KITAQSIGN_BASE_URL": "https://epp.kitaqsign.com",
        "KITAQNIC_BASE_URL": "https://epp.kitaqnic.com"
      },
      "observability": {
        "logs": {
          "enabled": false,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "db-production",
          "database_id": "2ba676de-7422-4e9e-971f-f084f812c5fb",
          "migrations_dir": "drizzle"
        }
      ],
      // B-C 対策: Wrangler の env override はトップレベル設定を継承しない項目もあるので、
      // 本番でも同じ cron 構成を明示的に再宣言する。
      // トップレベルと同じ値なので、変更時は両方を同期させること。
      "triggers": {
        "crons": ["* * * * *"]
      }
    }
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}