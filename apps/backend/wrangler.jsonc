{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-local",
      "database_id": "8e8147c0-2a7c-4e14-97b6-8fd63e7cea85",
      "migrations_dir": "drizzle"
    }
  ],
  // レジストリ hello (supportedTlds) の応答を短時間キャッシュする。
  // ドメイン登録・移管申請のホットパスで hello を毎回叩くとレイテンシとエラー面が増えるので、
  // TTL 10 分でキャッシュする。TLD 追加・削除は最大 10 分遅れて反映される。
  "kv_namespaces": [
    {
      "binding": "REGISTRY_HELLO_CACHE",
      "id": "9e1a28e8384a4582a06b56fbb0977e64"
    }
  ],
  "vars": {
    "BACKEND_URL": "http://localhost:8787",
    "FRONTEND_URL": "http://localhost:3000",
    "crossSubDomainCookies": "localhost",
    "KITAQSIGN_BASE_URL": "https://epp.kitaqsign.com",
    "KITAQNIC_BASE_URL": "https://epp.kitaqnic.com",
    // hello (supportedTlds) が長時間落ちたときだけ使う静的フォールバック。
    // カンマ区切り。TLD の増減時は wrangler.jsonc の両環境を同期させる。
    "KITAQSIGN_FALLBACK_TLDS": "com,net",
    "KITAQNIC_FALLBACK_TLDS": "xyz,shop,store,app,dev,io,site,online,tech,space,click,link,top,world,life,cloud,email,fun,org,info"
  },
  "triggers": {
    // 移管ポーリングは 1 分ごとの cron で駆動する (scheduled/transfer-cron-poll)。
    // 発火のたびに両レジストリを空になるまで poll drain して確定処理し、22 分以上経過した
    // pendingTransfer は info で真実確認して serverApproved / expired に確定させる。
    // Cloudflare Queues は一切使わず、Cron トリガーだけで移管の poll と reconcile を完結させる。
    "crons": ["* * * * *"]
  },
  // Workers Logs を無効化しつつ invocation_logs だけ残す。
  // invocation_logs はリクエスト単位の "誰がいつ何を叩いたか" のヘッダ相当で
  // 課金対象外。詳細ログ (console.log の中身) は使わないので保存しない。
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },
  "env": {
    "production": {
      "name": "backend-production",
      "vars": {
        "BACKEND_URL": "https://backend-production.fatricepaddy.workers.dev",
        "FRONTEND_URL": "https://frontend-production.fatricepaddy.workers.dev",
        "crossSubDomainCookies": ".fatricepaddy.workers.dev",
        "KITAQSIGN_BASE_URL": "https://epp.kitaqsign.com",
        "KITAQNIC_BASE_URL": "https://epp.kitaqnic.com",
        "KITAQSIGN_FALLBACK_TLDS": "com,net,org,info",
        "KITAQNIC_FALLBACK_TLDS": "xyz,shop,store,app,dev,io,site,online,tech,space,click,link,top,world,life,cloud,email,fun"
      },
      "observability": {
        "logs": {
          "enabled": false,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "db-production",
          "database_id": "2ba676de-7422-4e9e-971f-f084f812c5fb",
          "migrations_dir": "drizzle"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "REGISTRY_HELLO_CACHE",
          "id": "806232c2ae224c58adab367b744b2777"
        }
      ],
      // B-C 対策: Wrangler の env override はトップレベル設定を継承しない項目もあるので、
      // 本番でも同じ cron 構成を明示的に再宣言する。
      // トップレベルと同じ値なので、変更時は両方を同期させること。
      "triggers": {
        "crons": ["* * * * *"]
      }
    }
  },
  "compatibility_flags": ["nodejs_compat"],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}