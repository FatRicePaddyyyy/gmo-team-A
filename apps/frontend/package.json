{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.26.0",
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@hookform/resolvers": "latest",
		"@vinext/cloudflare": "latest",
		"backend": "workspace:*",
		"better-auth": "1.4.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "4.11.1",
		"lucide-react": "^1.34.0",
		"react": "latest",
		"react-dom": "latest",
		"react-hook-form": "7.65.0",
		"react-server-dom-webpack": "latest",
		"shadcn": "^4.19.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"vinext": "latest",
		"zod": "4.2.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.48.0",
		"@cloudflare/vite-plugin": "latest",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^9.39.5",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"eslint": "^9.39.5",
		"eslint-config-next": "15.4.5",
		"eslint-plugin-unicorn": "^60.0.0",
		"tailwindcss": "latest",
		"typescript": "5.9.2",
		"vite": "latest",
		"wrangler": "latest"
	},
	"type": "module",
	"scripts": {
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"preview": "pnpm run build && pnpm run start",
		"deploy": "vinext-cloudflare deploy --env production --name frontend-production",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
		"lint": "eslint . --config ./eslint.config.mjs --ext .js,.jsx,.ts,.tsx,.mjs",
		"lint:staged": "eslint --config ./eslint.config.mjs --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings=0 --no-warn-ignored",
		"lint:fix": "eslint . --config ./eslint.config.mjs --ext .js,.jsx,.ts,.tsx,.mjs --fix",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed"
	}
}
